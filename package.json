{
  "name": "tos-summarizer-extension",
  "version": "1.3.0",
  "description": "Firefox extension that summarizes Terms of Service and Privacy Policies using Google Gemini AI.",
  "author": "Geralt4 <https://github.com/Geralt4>",
  "license": "MIT",
  "homepage": "https://github.com/Geralt4/ToS-Summarizer-Extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Geralt4/ToS-Summarizer-Extension.git"
  },
  "bugs": {
    "url": "https://github.com/Geralt4/ToS-Summarizer-Extension/issues"
  },
  "keywords": [
    "firefox",
    "extension",
    "browser-extension",
    "terms-of-service",
    "privacy-policy",
    "gemini",
    "ai",
    "summarizer"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "check": "npm run lint && npm test"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "background.js",
      "popup.js",
      "extract.js",
      "options.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jsdom": "^26.1.0",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
